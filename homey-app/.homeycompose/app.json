{
    "id": "nl.inversion.homeydashboard",
    "version": "1.0.0",
    "compatibility": ">=12.4.0",
    "sdk": 3,
    "runtime": "nodejs",
    "platforms": [
        "local"
    ],
    "name": {
        "en": "Homey Dashboard Controller",
        "nl": "Homey Dashboard Controller"
    },
    "description": {
        "en": "Controls several functions of the Homey Dashboard docker container",
        "nl": "Bedient functies van de Homey Dashboard docker-container"
    },
    "category": [
        "tools"
    ],
    "brandColor": "#4da3ff",
    "permissions": [],
    "images": {
        "small": "/assets/images/small.jpg",
        "large": "/assets/images/large.jpg",
        "xlarge": "/assets/images/xlarge.jpg"
    },
    "author": {
        "name": "Robin van Kekem"
    },
    "contributing": {
        "donate": {
            "paypal": {
                "username": "RvanKekem"
            }
        }
    },
    "bugs": {
        "url": "https://github.com/RoadXY/homey_dashboard/issues"
    },
    "support": "https://github.com/RoadXY/homey_dashboard/issues",
    "source": "https://github.com/RoadXY/homey_dashboard/",
    "homepage": "https://www.inversion.nl",
    "api": {
        "getNotifications": {
            "method": "GET",
            "path": "/notifications"
        },
        "deleteNotification": {
            "method": "DELETE",
            "path": "/notification/:id"
        }
    }
}
