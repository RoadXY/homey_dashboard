{
  "title": {
    "en": "Delete notification with exact title",
    "nl": "Verwijder melding met exacte titel"
  },
  "titleFormatted": {
    "en": "Delete notification with exact title [[searchText]]",
    "nl": "Verwijder melding met exacte titel [[searchText]]"
  },
  "hint": {
    "en": "Case-insensitive, the whole title must match. Deletes every matching notification created through this app. If none match, the flow shows an error.",
    "nl": "Hoofdletterongevoelig, de hele titel moet overeenkomen. Verwijdert elke overeenkomende melding die via deze app is aangemaakt. Komt er niets overeen, dan geeft de flow een fout."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=dashboard"
    },
    {
      "type": "text",
      "name": "searchText",
      "title": {
        "en": "Exact title",
        "nl": "Exacte titel"
      },
      "placeholder": {
        "en": "Water alarm",
        "nl": "Wateralarm"
      }
    }
  ],
  "tokens": [
    {
      "name": "deletedCount",
      "type": "number",
      "title": {
        "en": "Deleted notifications",
        "nl": "Aantal verwijderde meldingen"
      },
      "example": {
        "en": "1",
        "nl": "1"
      }
    }
  ]
}
