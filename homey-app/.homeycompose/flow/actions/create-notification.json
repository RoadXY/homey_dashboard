{
  "title": {
    "en": "Create notification",
    "nl": "Melding aanmaken"
  },
  "titleFormatted": {
    "en": "Create [[severity]] notification '[[title]]': [[message]] (expires: [[expiresInMinutes]])",
    "nl": "Maak [[severity]] melding '[[title]]': [[message]] (verloopt: [[expiresInMinutes]])"
  },
  "hint": {
    "en": "Creates a notification on the dashboard. The ID is returned as a token so you can update or delete it later.",
    "nl": "Maakt een melding op het dashboard aan. Het ID wordt als token teruggegeven, zodat je de melding later kunt wijzigen of verwijderen."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=dashboard"
    },
    {
      "type": "text",
      "name": "title",
      "title": {
        "en": "Title",
        "nl": "Titel"
      },
      "placeholder": {
        "en": "Water alarm",
        "nl": "Wateralarm"
      }
    },
    {
      "type": "text",
      "name": "message",
      "title": {
        "en": "Message",
        "nl": "Bericht"
      },
      "placeholder": {
        "en": "Water detected near the washing machine",
        "nl": "Water gedetecteerd bij de wasmachine"
      }
    },
    {
      "type": "dropdown",
      "name": "severity",
      "title": {
        "en": "Severity",
        "nl": "Ernst"
      },
      "values": [
        { "id": "critical", "label": { "en": "Critical", "nl": "Kritiek" } },
        { "id": "warning", "label": { "en": "Warning", "nl": "Waarschuwing" } },
        { "id": "info", "label": { "en": "Info", "nl": "Info" } }
      ]
    },
    {
      "type": "dropdown",
      "name": "expiresInMinutes",
      "title": {
        "en": "Expires after",
        "nl": "Verloopt na"
      },
      "hint": {
        "en": "Optional. Defaults to never expiring.",
        "nl": "Optioneel. Standaard verloopt de melding nooit."
      },
      "values": [
        { "id": "0", "label": { "en": "Never", "nl": "Nooit" } },
        { "id": "5", "label": { "en": "5 minutes", "nl": "5 minuten" } },
        { "id": "15", "label": { "en": "15 minutes", "nl": "15 minuten" } },
        { "id": "30", "label": { "en": "30 minutes", "nl": "30 minuten" } },
        { "id": "60", "label": { "en": "1 hour", "nl": "1 uur" } },
        { "id": "120", "label": { "en": "2 hours", "nl": "2 uur" } },
        { "id": "360", "label": { "en": "6 hours", "nl": "6 uur" } },
        { "id": "720", "label": { "en": "12 hours", "nl": "12 uur" } },
        { "id": "1440", "label": { "en": "1 day", "nl": "1 dag" } },
        { "id": "2880", "label": { "en": "2 days", "nl": "2 dagen" } },
        { "id": "10080", "label": { "en": "1 week", "nl": "1 week" } }
      ]
    }
  ],
  "tokens": [
    {
      "name": "id",
      "type": "string",
      "title": {
        "en": "Notification ID",
        "nl": "Melding-ID"
      },
      "example": {
        "en": "3f2a9c1e-8b7d-4e2a-9c1f-0a1b2c3d4e5f",
        "nl": "3f2a9c1e-8b7d-4e2a-9c1f-0a1b2c3d4e5f"
      }
    }
  ]
}
