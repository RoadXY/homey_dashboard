{
  "title": {
    "en": "Set weather condition",
    "nl": "Weersomstandigheid instellen"
  },
  "titleFormatted": {
    "en": "Set the dashboard weather to [[condition]]",
    "nl": "Zet het weer op het dashboard op [[condition]]"
  },
  "hint": {
    "en": "Sets the weather condition shown on the dashboard. It stays active until another condition is set.",
    "nl": "Stelt de weersomstandigheid in die op het dashboard getoond wordt. Die blijft staan tot er een andere wordt ingesteld."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=dashboard"
    },
    {
      "type": "dropdown",
      "name": "condition",
      "title": {
        "en": "Condition",
        "nl": "Omstandigheid"
      },
      "values": [
        { "id": "sunny", "label": { "en": "Sunny", "nl": "Zonnig" } },
        { "id": "mostly_sunny", "label": { "en": "Mostly sunny", "nl": "Overwegend zonnig" } },
        { "id": "partly_cloudy", "label": { "en": "Partly cloudy", "nl": "Half bewolkt" } },
        { "id": "cloudy", "label": { "en": "Cloudy", "nl": "Bewolkt" } },
        { "id": "overcast", "label": { "en": "Overcast", "nl": "Zwaar bewolkt" } },
        { "id": "fog", "label": { "en": "Fog", "nl": "Mist" } },
        { "id": "drizzle", "label": { "en": "Drizzle", "nl": "Motregen" } },
        { "id": "rain", "label": { "en": "Rain", "nl": "Regen" } },
        { "id": "heavy_rain", "label": { "en": "Heavy rain", "nl": "Zware regen" } },
        { "id": "showers", "label": { "en": "Showers", "nl": "Buien" } },
        { "id": "thunderstorm", "label": { "en": "Thunderstorm", "nl": "Onweer" } },
        { "id": "hail", "label": { "en": "Hail", "nl": "Hagel" } },
        { "id": "snow", "label": { "en": "Snow", "nl": "Sneeuw" } },
        { "id": "snow_showers", "label": { "en": "Snow showers", "nl": "Sneeuwbuien" } },
        { "id": "sleet", "label": { "en": "Sleet", "nl": "IJzel" } },
        { "id": "windy", "label": { "en": "Windy", "nl": "Winderig" } }
      ]
    }
  ]
}
