{
  "title": {
    "en": "Show camera popup for a time",
    "nl": "Toon camerabeeld voor een tijd"
  },
  "titleFormatted": {
    "en": "Show [[camera]] with title '[[title]]' for [[expiresInMinutes]]",
    "nl": "Toon [[camera]] met titel '[[title]]' voor [[expiresInMinutes]]"
  },
  "hint": {
    "en": "Shows the live feed of a camera as a popup on the dashboard. The popup closes automatically after the chosen time, or earlier when it is closed, replaced or dismissed on the dashboard.",
    "nl": "Toont het live beeld van een camera als popup op het dashboard. De popup sluit automatisch na de gekozen tijd, of eerder als hij wordt gesloten, vervangen of op het dashboard weggedrukt."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=dashboard"
    },
    {
      "type": "device",
      "name": "camera",
      "title": {
        "en": "Camera",
        "nl": "Camera"
      }
    },
    {
      "type": "text",
      "name": "title",
      "title": {
        "en": "Title",
        "nl": "Titel"
      },
      "placeholder": {
        "en": "Front door open",
        "nl": "Voordeur open"
      }
    },
    {
      "type": "dropdown",
      "name": "expiresInMinutes",
      "title": {
        "en": "Close after",
        "nl": "Sluit na"
      },
      "values": [
        { "id": "1", "label": { "en": "1 minute", "nl": "1 minuut" } },
        { "id": "5", "label": { "en": "5 minutes", "nl": "5 minuten" } },
        { "id": "15", "label": { "en": "15 minutes", "nl": "15 minuten" } },
        { "id": "30", "label": { "en": "30 minutes", "nl": "30 minuten" } },
        { "id": "60", "label": { "en": "1 hour", "nl": "1 uur" } },
        { "id": "120", "label": { "en": "2 hours", "nl": "2 uur" } },
        { "id": "360", "label": { "en": "6 hours", "nl": "6 uur" } },
        { "id": "720", "label": { "en": "12 hours", "nl": "12 uur" } },
        { "id": "1440", "label": { "en": "24 hours", "nl": "24 uur" } }
      ]
    }
  ]
}
