{
  "title": {
    "en": "Change expiry of notifications with text in title",
    "nl": "Wijzig vervaltijd van meldingen met tekst in de titel"
  },
  "titleFormatted": {
    "en": "Change expiry of all notifications with [[searchText]] in the title to [[expiresInMinutes]]",
    "nl": "Wijzig vervaltijd van alle meldingen met [[searchText]] in de titel naar [[expiresInMinutes]]"
  },
  "hint": {
    "en": "Case-insensitive. Changes the expiry of notifications whose title contains the text. 'Never' keeps them until deleted.",
    "nl": "Hoofdletterongevoelig. Past de vervaltijd aan van meldingen waarvan de titel de tekst bevat. 'Nooit' laat ze staan tot ze verwijderd worden."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=dashboard"
    },
    {
      "type": "text",
      "name": "searchText",
      "title": {
        "en": "Text in title",
        "nl": "Tekst in titel"
      },
      "placeholder": {
        "en": "Water",
        "nl": "Water"
      }
    },
    {
      "type": "dropdown",
      "name": "expiresInMinutes",
      "title": {
        "en": "Expires after",
        "nl": "Verloopt na"
      },
      "values": [
        { "id": "0", "label": { "en": "Never", "nl": "Nooit" } },
        { "id": "5", "label": { "en": "5 minutes", "nl": "5 minuten" } },
        { "id": "15", "label": { "en": "15 minutes", "nl": "15 minuten" } },
        { "id": "30", "label": { "en": "30 minutes", "nl": "30 minuten" } },
        { "id": "60", "label": { "en": "1 hour", "nl": "1 uur" } },
        { "id": "120", "label": { "en": "2 hours", "nl": "2 uur" } },
        { "id": "360", "label": { "en": "6 hours", "nl": "6 uur" } },
        { "id": "720", "label": { "en": "12 hours", "nl": "12 uur" } },
        { "id": "1440", "label": { "en": "1 day", "nl": "1 dag" } },
        { "id": "2880", "label": { "en": "2 days", "nl": "2 dagen" } },
        { "id": "10080", "label": { "en": "1 week", "nl": "1 week" } }
      ]
    }
  ],
  "tokens": [
    {
      "name": "updatedCount",
      "type": "number",
      "title": {
        "en": "Updated notifications",
        "nl": "Aantal gewijzigde meldingen"
      },
      "example": {
        "en": "2",
        "nl": "2"
      }
    }
  ]
}