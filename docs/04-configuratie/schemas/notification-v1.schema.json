{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homey-dashboard.local/schemas/notification-v1.schema.json",
  "title": "Homey Dashboard notification configuration",
  "description": "Canonical version 1 model for dashboard-owned notification rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "message", "severity", "enabled", "condition"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "message": { "type": "string" },
    "icon": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "warning", "info"] },
    "enabled": { "type": "boolean" },
    "testOnly": { "type": "boolean", "default": false },
    "condition": { "$ref": "#/$defs/conditionNode" }
  },
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "deviceId", "capabilityId", "expectedType"],
          "properties": {
            "type": { "const": "device-capability" },
            "deviceId": { "type": "string", "minLength": 1 },
            "capabilityId": { "type": "string", "minLength": 1 },
            "expectedType": { "enum": ["boolean", "number"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "variableId", "expectedType"],
          "properties": {
            "type": { "const": "logic-variable" },
            "variableId": { "type": "string", "minLength": 1 },
            "expectedType": { "enum": ["boolean", "number"] }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "value"],
      "properties": {
        "operator": { "enum": ["equals", "lessThan", "greaterThan"] },
        "value": { "type": ["boolean", "number"] }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "enum": ["lessThan", "greaterThan"] } }, "required": ["operator"] },
          "then": { "properties": { "value": { "type": "number" } } }
        }
      ]
    },
    "conditionNode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source", "condition"],
          "properties": {
            "type": { "const": "comparison" },
            "source": { "$ref": "#/$defs/source" },
            "condition": { "$ref": "#/$defs/comparison" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "conditions"],
          "properties": {
            "operator": { "enum": ["and", "or"] },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/conditionNode" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "durationMs", "condition"],
          "properties": {
            "type": { "const": "duration" },
            "id": { "type": "string", "minLength": 1 },
            "durationMs": { "type": "integer", "minimum": 1 },
            "condition": { "$ref": "#/$defs/conditionNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "configured", "weekdays"],
          "properties": {
            "type": { "const": "schedule" },
            "configured": { "const": false },
            "weekdays": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "weekdays", "startTime", "endTime"],
          "properties": {
            "type": { "const": "schedule" },
            "weekdays": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 6 }
            },
            "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "timeZone": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
