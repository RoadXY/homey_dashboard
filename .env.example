# Alleen niet-geheime voorbeeldinstellingen.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Homey Pro 2023 – vul lokaal in .env in, nooit in GitHub.
HOMEY_ADDRESS=http://192.168.1.123
HOMEY_API_KEY=

# PIN voor de verborgen instellingenroute (kies zelf een unieke code in je lokale .env).
SETTINGS_PIN=

# Token voor POST /api/v1/weather/conditions (genereer een lange willekeurige waarde; nooit committen).\nWEATHER_API_TOKEN=\n\n# Persistente dashboardinstellingen; productie gebruikt het Docker-volume dashboard_data.
DATA_DIR=/app/data
