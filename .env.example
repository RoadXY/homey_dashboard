# Alleen niet-geheime voorbeeldinstellingen.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Production host port (host mode default and bridge published port).
DASHBOARD_PORT=5173

# Homey Pro 2023 – vul lokaal in .env in, nooit in GitHub.
HOMEY_ADDRESS=http://192.168.1.123
HOMEY_API_KEY=

# PIN voor de verborgen instellingenroute (kies zelf een unieke code in je lokale .env).
SETTINGS_PIN=

# Token for POST /api/v1/weather/conditions (generate a long random value; never commit it).
WEATHER_API_TOKEN=

DATA_DIR=/app/data

# Local mDNS-SD discovery. Leave the name empty to generate and persist a Dutch two-word name.
# Set DASHBOARD_INSTANCE_NAME=Woonkamer for "Homey Dashboard - Woonkamer".
DASHBOARD_INSTANCE_NAME=
MDNS_ENABLED=true
